{
	"name": "blog",
	"version": "1.0.0",
	"description": "",
	"keywords": [],
	"license": "ISC",
	"type": "module",
	"author": "",
	"main": "index.js",
	"scripts": {
		"dev": "NODE_ENV=development rspack serve --config rspack.config.dev.ts",
		"dev:watch": "node --watch=src scripts/build-watch.mjs",
		"build": "pnpm clean && NODE_ENV=production pnpm generate:tcm && pnpm build:client && pnpm build:server && pnpm invoke:ssg && pnpm copy:assets",
		"invoke:ssg": "node ./dist/build.js",
		"__rspack": "NODE_OPTIONS=\"--loader ts-node/esm\" rspack",
		"build:client": "NODE_ENV=production pnpm __rspack build --config rspack.config.client.ts",
		"build:server": "NODE_ENV=production pnpm __rspack build --config rspack.config.server.ts",
		"copy:assets": "cp -r ./src/assets/* ./public/assets/",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"generate:tcm": "tcm src",
		"components-catalogue:serve": "ladle serve",
		"clean": "rimraf public"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.1.0",
		"front-matter": "^4.0.2",
		"hast-util-select": "^5.0.2",
		"image-to-base64": "^2.2.0",
		"marked": "^15.0.12",
		"option-t": "^39.0.3",
		"react": "19.0.0-beta-94eed63c49-20240425",
		"react-aria-components": "^1.3.3",
		"react-dom": "19.0.0-beta-94eed63c49-20240425",
		"rehype-highlight": "^6.0.0",
		"rehype-stringify": "^9.0.3",
		"remark-gfm": "^3.0.1",
		"remark-parse": "^10.0.0",
		"remark-rehype": "^10.1.0",
		"satori": "^0.0.43",
		"ssg-router": "workspace:*",
		"unified": "^10.0.4",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@ladle/react": "^4.1.1",
		"@rspack/cli": "0.6.0",
		"@rspack/core": "0.6.0",
		"@rspack/plugin-react-refresh": "0.6.0",
		"@swc/core": "^1.3.100",
		"@types/image-to-base64": "^2.1.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.13.5",
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.0",
		"@types/unist": "^3.0.3",
		"build-tool": "workspace:*",
		"css-loader": "^6.3.0",
		"postcss-loader": "^8.1.1",
		"react-refresh": "^0.14.0",
		"rimraf": "^4.1.2",
		"style-loader": "^3.3.4",
		"ts-node": "^10.2.1",
		"typed-css-modules": "^0.9.1",
		"vitest": "^1.5.2",
		"webpack-merge": "^5.8.0"
	}
}
