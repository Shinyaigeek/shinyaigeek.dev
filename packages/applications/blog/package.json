{
	"name": "blog",
	"version": "1.0.0",
	"description": "",
	"keywords": [],
	"license": "ISC",
	"type": "module",
	"author": "",
	"main": "index.js",
	"scripts": {
		"dev": "NODE_ENV=development tsx scripts/dev.ts",
		"build": "pnpm clean && NODE_ENV=production pnpm generate:tcm && pnpm build:client && pnpm build:server && pnpm invoke:ssg && pnpm copy:assets && pnpm verify:og",
		"invoke:ssg": "node ./dist/build.js",
		"__rspack": "rspack",
		"build:client": "NODE_ENV=production pnpm __rspack build --config rspack.config.client.ts",
		"build:server": "NODE_ENV=production pnpm __rspack build --config rspack.config.server.ts",
		"copy:assets": "cp -r ./src/assets/* ./public/assets/",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"generate:tcm": "tcm src",
		"components-catalogue:serve": "ladle serve",
		"clean": "rimraf public",
		"verify:og": "node scripts/verify-og-metadata.mjs"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"front-matter": "^4.0.2",
		"hast-util-select": "^6.0.4",
		"marked": "^18.0.7",
		"option-t": "^56.1.2",
		"react": "^19.2.8",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.8",
		"rehype-highlight": "^7.0.2",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"satori": "^0.29.0",
		"ssg-router": "workspace:*",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@ladle/react": "^5.1.1",
		"@rspack/cli": "2.1.6",
		"@rspack/core": "2.1.6",
		"@swc/core": "^1.15.46",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/unist": "^3.0.3",
		"build-tool": "workspace:*",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.1",
		"typed-css-modules": "^0.9.1",
		"vitest": "^4.1.10",
		"webpack-merge": "^6.0.1"
	}
}
