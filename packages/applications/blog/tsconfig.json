{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		// @ladle/react still pulls in @types/mdx and prism-react-renderer, which
		// reference the global JSX namespace that React 19 types removed.
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		// @ladle/react publishes .tsx typings that TypeScript 7 resolves ahead of
		// the .d.ts beside them and then type-checks, and skipLibCheck above only
		// covers .d.ts. The stories use the Story type against the local stand-in
		// instead; src/types/ladle.d.ts has the whole story.
		"paths": {
			"@ladle/react": ["./src/types/ladle"]
		}
	},
	"include": [
		"src",
		"scripts",
		"rspack.config.client.ts",
		"rspack.config.dev.ts",
		"rspack.config.server.ts"
	]
}
