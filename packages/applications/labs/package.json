		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@swc/core": "^1.15.46",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"build-tool": "workspace:*",
		"css-loader": "^7.1.4",
		"mini-css-extract-plugin": "^2.10.2",
		"rimraf": "^6.1.3",
		"style-loader": "^4.0.0",
		"swc-loader": "^0.2.7",
		"ts-node": "^10.9.2",
		"webpack": "^5.109.0",
		"webpack-cli": "^7.2.1",
		"webpack-merge": "^6.0.1"
	}
