{
	"extends": "../../../tsconfig.base.json",
	// build-tool is a workspace dependency, so it resolves through node_modules
	// like any other package -- the old `paths` mapping and project reference
	// were only needed before that.
	"include": [
		"src",
		"tools",
		"scripts",
		"webpack.config.client.ts",
		"webpack.config.dev.ts",
		"webpack.config.server.ts"
	]
}
