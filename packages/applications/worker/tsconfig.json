{
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"lib": ["esnext"],
		"strict": true,
		"preserveConstEnums": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src"]
}
